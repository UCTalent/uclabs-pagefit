{
  "name": "@uclabs/react-pagefit",
  "version": "0.1.1",
  "description": "React component that lays content out as fixed-size pages (A4, Letter…) without ever cutting a line.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UCTalent/uclabs-pagefit.git",
    "directory": "packages/react-pagefit"
  },
  "homepage": "https://github.com/UCTalent/uclabs-pagefit/tree/main/packages/react-pagefit#readme",
  "bugs": {
    "url": "https://github.com/UCTalent/uclabs-pagefit/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "react",
    "pagination",
    "print",
    "pdf",
    "a4",
    "paged-media",
    "resume"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@uclabs/pagefit": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
